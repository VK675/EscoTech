<?xml version="1.0" encoding="utf-8"?>
<!-- Um desafio na lista (RecyclerView) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EscoTech.Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Ciclo for" />

            <TextView
                android:id="@+id/tvXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_etiqueta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/destaque"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="+50 XP" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            tools:text="Contar quantas vezes um ciclo é executado." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDificuldade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_etiqueta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/secundaria"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Iniciante" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_etiqueta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Prazo: 24/10/2026"
                tools:textColor="@color/primaria" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
