<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das opções de resposta: muda quando a opção está selecionada -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cartao" />
            <stroke android:width="2dp" android:color="@color/secundaria" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/contorno" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
